<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Medicine name row + remove -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtCartItemName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paracetamol"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"/>

                <TextView
                    android:id="@+id/txtCartItemStrength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500mg · Tablet"
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"/>
            </LinearLayout>

            <!-- Rx badge -->
            <TextView
                android:id="@+id/txtCartItemRx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚕️ Rx"
                android:textSize="11sp"
                android:textColor="#E65100"
                android:background="#FFF8E1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"/>

            <!-- Remove button -->
            <ImageView
                android:id="@+id/btnCartRemove"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_close"
                android:tint="#BDBDBD"
                android:padding="2dp"/>
        </LinearLayout>

        <!-- Price + quantity controls + item total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtCartItemPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="₹6.50/strip"
                android:textSize="13sp"
                android:textColor="#757575"/>

            <!-- − qty + controls -->
            <LinearLayout
                android:id="@+id/btnCartMinus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:background="@drawable/rounded_outline_blue">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="−"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtCartQty"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:gravity="center"/>

            <LinearLayout
                android:id="@+id/btnCartPlus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:background="@drawable/rounded_outline_blue"
                android:layout_marginEnd="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtCartItemTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹6.50"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1565C0"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>