<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="44dp"
        android:paddingBottom="14dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnOwnerReservBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF"
            android:padding="4dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtOwnerReservHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reservations"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage pickup queue"
                android:textSize="12sp"
                android:textColor="#B3E5FC"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Filter chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/chipOwnerAll"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="All"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/pill_primary"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/chipOwnerPending"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Pending"
            android:textSize="13sp"
            android:textColor="#1565C0"
            android:background="@drawable/rounded_outline_blue"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/chipOwnerCollected"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Collected"
            android:textSize="13sp"
            android:textColor="#1565C0"
            android:background="@drawable/rounded_outline_blue"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressOwnerReserv"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/txtOwnerReservEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No reservations yet"
        android:textSize="15sp"
        android:textColor="#9E9E9E"
        android:gravity="center"
        android:padding="48dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOwnerReservations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp"
        android:clipToPadding="false"/>

</LinearLayout>