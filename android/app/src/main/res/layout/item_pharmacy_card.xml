<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPharmacy"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top row: rank badge + name + distance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/txtRank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#1"
                android:textSize="11sp"
                android:textColor="#1565C0"
                android:background="@drawable/rounded_outline_blue"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/txtPharmacyName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Metro Medicals"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/txtDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.2 km"
                android:textSize="13sp"
                android:textColor="#1565C0"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Address -->
        <TextView
            android:id="@+id/txtPharmacyDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MG Road, Kottayam"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="6dp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- Medicine banner — shown only during medicine search -->
        <LinearLayout
            android:id="@+id/layoutMedicineBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F0F7FF"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <!-- Medicine name + strength -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtCardMedicineName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paracetamol 500mg"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"/>

                <TextView
                    android:id="@+id/txtCardStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ In Stock (45 strips)"
                    android:textSize="11sp"
                    android:textColor="#2E7D32"/>
            </LinearLayout>

            <!-- Price -->
            <TextView
                android:id="@+id/txtPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹6.50"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1565C0"/>
        </LinearLayout>

        <!-- Status + Rating row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Open"
                android:textSize="12sp"
                android:textColor="#2E7D32"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/txtRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★ 4.5"
                android:textSize="12sp"
                android:textColor="#F57F17"/>

        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#F0F0F0" android:layout_marginBottom="10dp"/>

        <!-- Action buttons — normal view (no medicine search) -->
        <LinearLayout
            android:id="@+id/layoutNormalButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnDirections"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/rounded_outline_blue"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗺 Directions"
                    android:textSize="12sp"
                    android:textColor="#1565C0"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/rounded_outline_blue"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞 Call"
                    android:textSize="12sp"
                    android:textColor="#1565C0"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMore"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/pill_primary">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Details ›"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Medicine search buttons — Book + Directions + Details -->
        <LinearLayout
            android:id="@+id/layoutMedicineButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- BOOK NOW — single medicine reservation -->
            <LinearLayout
                android:id="@+id/btnBookNow"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="2"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/pill_primary"
                android:layout_marginEnd="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Book Now"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- ADD TO CART — for multi-medicine orders -->
            <LinearLayout
                android:id="@+id/btnAddToCart"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#E3F2FD"
                android:layout_marginEnd="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛒+"
                    android:textSize="16sp"
                    android:textColor="#1565C0"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDirectionsMed"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/rounded_outline_blue"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗺"
                    android:textSize="16sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMoreMed"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/rounded_outline_blue">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️"
                    android:textSize="16sp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>