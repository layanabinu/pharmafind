<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardResHistory"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ID + Status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtResId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 PF3A9B2C1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="#212121"/>

            <TextView
                android:id="@+id/txtResStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ Pending"
                android:textSize="11sp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#EEEEEE" android:layout_marginVertical="10dp"/>

        <!-- Medicine + Pharmacy -->
        <TextView
            android:id="@+id/txtResMedicine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💊 Metformin × 2"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <TextView
            android:id="@+id/txtResPharmacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏪 Metro Medicals, Kottayam"
            android:textSize="13sp"
            android:textColor="#546E7A"
            android:layout_marginTop="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/txtResPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="₹84.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary"/>

            <TextView
                android:id="@+id/txtResRx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚕️ Bring Prescription"
                android:textSize="11sp"
                android:textColor="#E65100"
                android:background="#FFF3E0"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtResExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏰ Collect by: 2025-01-15 14:30"
            android:textSize="12sp"
            android:textColor="#F57C00"
            android:layout_marginTop="6dp"
            android:visibility="gone"/>

        <!-- Action buttons (pending only) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnResCollected"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="✅ Mark Collected"
                android:textSize="12sp"
                android:backgroundTint="#1B5E20"
                android:textColor="#FFFFFF"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/btnResCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="❌ Cancel"
                android:textSize="12sp"
                android:backgroundTint="#B71C1C"
                android:textColor="#FFFFFF"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>