<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnCartBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            android:tint="@android:color/white"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛒 Your Cart"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/txtCartPharmacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Pharmacy Name"
                android:textColor="#B3E5FC"
                android:textSize="13sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtCartItemCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 items"
            android:textColor="#B3E5FC"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Cart list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false"/>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/layoutCartEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛒"
            android:textSize="56sp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your cart is empty"
            android:textSize="18sp"
            android:textColor="#9E9E9E"
            android:layout_marginTop="12dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search for a medicine and tap Book Pickup"
            android:textSize="13sp"
            android:textColor="#BDBDBD"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="32dp"/>
    </LinearLayout>

    <!-- Bottom summary + confirm -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Notes -->
            <EditText
                android:id="@+id/edtCartNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Add a note for the pharmacist (optional)"
                android:textSize="13sp"
                android:background="@drawable/rounded_outline_blue"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:maxLines="2"
                android:inputType="textMultiLine"/>

            <!-- Total + confirm row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txtCartTotal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total: ₹0.00"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#212121"/>

                <ProgressBar
                    android:id="@+id/progressCart"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="12dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btnCartConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Confirm Order"
                    android:textSize="15sp"
                    android:backgroundTint="@color/primary"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="24dp"
                    android:enabled="false"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>