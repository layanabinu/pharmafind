<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <!-- Timeline column: dot + vertical line -->
    <LinearLayout
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="4dp">

        <!-- Dot -->
        <View
            android:id="@+id/timelineDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#1E88E5"/>

        <!-- Vertical connecting line -->
        <View
            android:id="@+id/timelineLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="#E0E0E0"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/txtTimelineEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💊 Started taking"
            android:textSize="13sp"
            android:textColor="#1E88E5"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtTimelineMedicine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Metformin 500mg"
            android:textSize="15sp"
            android:textColor="#212121"
            android:textStyle="bold"
            android:layout_marginTop="2dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/txtTimelineDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 Jul 2025"
                android:textSize="12sp"
                android:textColor="#9E9E9E"/>

            <TextView
                android:id="@+id/txtTimelinePharmacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" · Metro Medicals"
                android:textSize="12sp"
                android:textColor="#9E9E9E"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>