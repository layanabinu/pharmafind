<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnInfoBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            android:tint="@android:color/white"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtInfoMedicineName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicine Name"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicine Information"
                android:textColor="#B3E5FC"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressInfoBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="48dp"
        android:visibility="gone"/>

    <!-- Error state -->
    <LinearLayout
        android:id="@+id/layoutInfoError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😕"
            android:textSize="48sp"/>

        <TextView
            android:id="@+id/txtInfoErrorMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Could not load medicine info"
            android:textSize="15sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnInfoRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Try Again"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/primary"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <!-- Main content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutInfoContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Identity card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtInfoGenericName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Generic name"
                        android:textSize="13sp"
                        android:textColor="#1565C0"
                        android:textStyle="italic"/>

                    <TextView
                        android:id="@+id/txtInfoStrengthForm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="500mg · Tablet"
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:layout_marginTop="2dp"/>

                    <TextView
                        android:id="@+id/txtInfoManufacturer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="By Manufacturer"
                        android:textSize="12sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/txtInfoDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:layout_marginTop="10dp"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Prescription warning -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardInfoRx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFF8E1"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtInfoRxWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="⚕️ Prescription Required"
                    android:textSize="13sp"
                    android:textColor="#E65100"
                    android:lineSpacingMultiplier="1.4"/>
            </androidx.cardview.widget.CardView>

            <!-- Uses section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:id="@+id/layoutInfoUses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"/>
            </androidx.cardview.widget.CardView>

            <!-- Side effects section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:id="@+id/layoutInfoSideEffects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"/>
            </androidx.cardview.widget.CardView>

            <!-- Patient reviews -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutInfoReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Patient Reviews"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="12dp"/>

                    <!-- Excellent -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="😊 Good"
                            android:textSize="13sp"
                            android:textColor="#2E7D32"/>
                        <ProgressBar
                            android:id="@+id/pbInfoExcellent"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_weight="1"
                            android:progressTint="#2E7D32"
                            android:progressBackgroundTint="#E0E0E0"
                            android:max="100"/>
                        <TextView
                            android:id="@+id/txtInfoExcellentPct"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="12sp"
                            android:textColor="#2E7D32"
                            android:gravity="end"/>
                    </LinearLayout>

                    <!-- Average -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="😐 Okay"
                            android:textSize="13sp"
                            android:textColor="#E65100"/>
                        <ProgressBar
                            android:id="@+id/pbInfoAverage"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_weight="1"
                            android:progressTint="#E65100"
                            android:progressBackgroundTint="#E0E0E0"
                            android:max="100"/>
                        <TextView
                            android:id="@+id/txtInfoAveragePct"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="12sp"
                            android:textColor="#E65100"
                            android:gravity="end"/>
                    </LinearLayout>

                    <!-- Poor -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:text="😞 Poor"
                            android:textSize="13sp"
                            android:textColor="#B71C1C"/>
                        <ProgressBar
                            android:id="@+id/pbInfoPoor"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_weight="1"
                            android:progressTint="#B71C1C"
                            android:progressBackgroundTint="#E0E0E0"
                            android:max="100"/>
                        <TextView
                            android:id="@+id/txtInfoPoorPct"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="12sp"
                            android:textColor="#B71C1C"
                            android:gravity="end"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtInfoReviewCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Based on patient reviews"
                        android:textSize="11sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-light"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Disclaimer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠ This information is for reference only. Always follow your doctor's advice and read the medicine leaflet before use. Do not self-medicate."
                android:textSize="11sp"
                android:textColor="#9E9E9E"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="8dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom search button -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <Button
                android:id="@+id/btnInfoSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🔍 Find This Medicine Near Me"
                android:textSize="14sp"
                android:backgroundTint="@color/primary"
                android:textColor="@android:color/white"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>