<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardOwnerItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Row 1: Stock badge + Medicine name + price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <!-- Colour-coded stock level dot -->
            <View
                android:id="@+id/viewStockDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/circle_shape"
                android:layout_marginEnd="10dp"/>

            <!-- Medicine name + strength -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtOwnerMedName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paracetamol"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/txtOwnerStrength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="500mg · Tablet"
                    android:textSize="11sp"
                    android:textColor="#9E9E9E"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <!-- Price (editable inline) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRICE"
                    android:textSize="9sp"
                    android:textColor="#BDBDBD"/>

                <TextView
                    android:id="@+id/txtOwnerPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹45.00"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1E88E5"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Inline stock editor: [−] [qty display] [+] + stock label -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp">

            <!-- Inline -/+ quick update: subtract 10 -->
            <LinearLayout
                android:id="@+id/btnQuickMinus"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:background="@drawable/rounded_outline_blue"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="−"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"/>
            </LinearLayout>

            <!-- Current stock display -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:background="#F5F5F5">

                <TextView
                    android:id="@+id/txtOwnerStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="120"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="strips"
                    android:textSize="9sp"
                    android:textColor="#9E9E9E"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Quick add +10 -->
            <LinearLayout
                android:id="@+id/btnQuickPlus"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:background="@drawable/rounded_outline_blue"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"/>
            </LinearLayout>

            <!-- Alert badge area -->
            <TextView
                android:id="@+id/txtOwnerAlert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✓ Stocked"
                android:textSize="11sp"
                android:textColor="#2E7D32"
                android:maxLines="2"
                android:gravity="start"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginBottom="8dp"/>

        <!-- Row 3: Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Set Stock (type exact number) -->
            <Button
                android:id="@+id/btnOwnerEdit"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Set Stock"
                android:textSize="11sp"
                android:backgroundTint="@color/primary"
                android:textColor="@android:color/white"/>

            <!-- Set Price -->
            <Button
                android:id="@+id/btnSetPrice"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="Set Price"
                android:textSize="11sp"
                android:backgroundTint="#00897B"
                android:textColor="@android:color/white"/>

            <!-- Forecast -->
            <Button
                android:id="@+id/btnOwnerChart"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="Forecast"
                android:textSize="11sp"
                android:backgroundTint="#7B1FA2"
                android:textColor="@android:color/white"/>

            <!-- Remove -->
            <Button
                android:id="@+id/btnOwnerDelete"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Remove"
                android:textSize="11sp"
                android:backgroundTint="@color/error"
                android:textColor="@android:color/white"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>