<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:padding="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnReminderBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF"
            android:padding="4dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reminders &amp; Sound"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage dose reminders and notifications"
                android:textSize="13sp"
                android:textColor="#B3E5FC"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── DOSE REMINDERS ──────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DOSE REMINDERS"
                android:textSize="11sp"
                android:textColor="#9E9E9E"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Morning dose -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌅  Morning Dose"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#212121"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Daily morning medicine reminder"
                                android:textSize="12sp"
                                android:textColor="#757575"/>
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchMorningDose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Morning time picker -->
                    <LinearLayout
                        android:id="@+id/layoutMorningTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="12dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="24dp"
                            android:layout_height="1dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Reminder time"
                            android:textSize="13sp"
                            android:textColor="#546E7A"/>

                        <TextView
                            android:id="@+id/txtMorningTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="08:00 AM"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:background="@drawable/rounded_outline_blue"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <!-- Evening dose -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌙  Evening Dose"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#212121"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Daily evening medicine reminder"
                                android:textSize="12sp"
                                android:textColor="#757575"/>
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchEveningDose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Evening time picker -->
                    <LinearLayout
                        android:id="@+id/layoutEveningTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="12dp"
                        android:visibility="gone">

                        <View android:layout_width="24dp" android:layout_height="1dp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Reminder time"
                            android:textSize="13sp"
                            android:textColor="#546E7A"/>

                        <TextView
                            android:id="@+id/txtEveningTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="08:00 PM"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:background="@drawable/rounded_outline_blue"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── SMART ALERTS ─────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SMART ALERTS"
                android:textSize="11sp"
                android:textColor="#9E9E9E"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Refill reminder -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💊  Low Stock Refill Alert"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#212121"/>
                            <TextView
                                android:id="@+id/txtRefillDaysLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alert me when 7 days of medicine remain"
                                android:textSize="12sp"
                                android:textColor="#757575"/>
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchRefillReminder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Refill days seeker -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1d"
                            android:textSize="12sp"
                            android:textColor="#9E9E9E"
                            android:layout_marginEnd="8dp"/>

                        <SeekBar
                            android:id="@+id/seekBarRefillDays"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="14"
                            android:progress="7"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14d"
                            android:textSize="12sp"
                            android:textColor="#9E9E9E"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <!-- Geofence alert -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📍  Nearby Pharmacy Alert"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#212121"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Notify when near a pharmacy (200m)"
                                android:textSize="12sp"
                                android:textColor="#757575"/>
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchGeofenceAlert"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <!-- Stock alert -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🚨  Critical Stock Alerts"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#212121"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Owner: alert when medicine critically low"
                                android:textSize="12sp"
                                android:textColor="#757575"/>
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchStockAlert"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <!-- Reservation expiry -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏰  Reservation Expiry Alert"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#212121"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Remind 2 hours before reservation expires"
                                android:textSize="12sp"
                                android:textColor="#757575"/>
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchReservationExpiry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── SOUND & VIBRATION ────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SOUND &amp; VIBRATION"
                android:textSize="11sp"
                android:textColor="#9E9E9E"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notification Sound"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="12dp"/>

                    <RadioGroup
                        android:id="@+id/rgNotificationSound"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbSoundDefault"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔔  Default notification sound"
                            android:textSize="14sp"
                            android:checked="true"
                            android:layout_marginBottom="8dp"/>

                        <RadioButton
                            android:id="@+id/rbSoundChime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎵  Chime"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp"/>

                        <RadioButton
                            android:id="@+id/rbSoundSilent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔕  Silent (badge only)"
                            android:textSize="14sp"/>
                    </RadioGroup>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginVertical="16dp"/>

                    <!-- Vibrate -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📳  Vibrate"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#212121"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vibrate with every notification"
                                android:textSize="12sp"
                                android:textColor="#757575"/>
                        </LinearLayout>
                        <Switch
                            android:id="@+id/switchVibrate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginVertical="16dp"/>

                    <!-- DND respect -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌙  Respect Do Not Disturb"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#212121"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Suppress alerts when DND is on"
                                android:textSize="12sp"
                                android:textColor="#757575"/>
                        </LinearLayout>
                        <Switch
                            android:id="@+id/switchDndRespect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Test button -->
            <Button
                android:id="@+id/btnTestNotification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔔  Send Test Notification"
                android:textSize="14sp"
                android:backgroundTint="#546E7A"
                android:textColor="#FFFFFF"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_marginBottom="12dp"/>

            <!-- Save button -->
            <Button
                android:id="@+id/btnSaveReminderSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save Settings"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                android:textColor="#FFFFFF"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>