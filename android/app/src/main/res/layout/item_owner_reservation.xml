<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top row: code + status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/txtOwnerReservCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="#PF1A2B3C"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="#757575"/>

            <TextView
                android:id="@+id/txtOwnerReservStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ Pending pickup"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#F57F17"/>
        </LinearLayout>

        <!-- Medicine name -->
        <TextView
            android:id="@+id/txtOwnerReservMed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paracetamol 500mg"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="4dp"/>

        <!-- Qty + expiry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/txtOwnerReservQty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Qty: 2"
                android:textSize="13sp"
                android:textColor="#757575"/>

            <TextView
                android:id="@+id/txtOwnerReservExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expires: 2026-01-01"
                android:textSize="12sp"
                android:textColor="#9E9E9E"/>
        </LinearLayout>

        <!-- Patient info -->
        <TextView
            android:id="@+id/txtOwnerReservPatient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Patient Name  📞 9400000001"
            android:textSize="13sp"
            android:textColor="#1565C0"
            android:layout_marginBottom="10dp"/>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOwnerCollect"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="✅ Mark Collected"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E7D32"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnOwnerCancelReserv"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textSize="12sp"
                android:textColor="#B71C1C"
                android:backgroundTint="#FFEBEE"
                style="@style/Widget.MaterialComponents.Button"/>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>