<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <!-- ── HEADER ─────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="vertical"
        android:paddingTop="44dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp">

        <!-- Top row: pharmacy name + profile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Owner Dashboard"
                    android:textSize="13sp"
                    android:textColor="#B3E5FC"/>

                <TextView
                    android:id="@+id/txtOwnerPharmacyHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Pharmacy"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- Notifications bell -->
            <LinearLayout
                android:id="@+id/btnOwnerAlerts"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:background="@drawable/circle_white"
                android:layout_marginEnd="10dp">
                <TextView
                    android:id="@+id/txtAlertBell"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔔"
                    android:textSize="18sp"/>
            </LinearLayout>

            <!-- Profile -->
            <LinearLayout
                android:id="@+id/btnOwnerProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:background="@drawable/circle_white">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_person"
                    app:tint="#1565C0"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── STAT CARDS ROW ──────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Total Medicines -->
            <LinearLayout
                android:id="@+id/cardStatTotal"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/rounded_white_card"
                android:layout_marginEnd="8dp">
                <TextView
                    android:id="@+id/txtStatTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medicines"
                    android:textSize="11sp"
                    android:textColor="#757575"/>
            </LinearLayout>

            <!-- Low Stock -->
            <LinearLayout
                android:id="@+id/cardStatLow"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/rounded_white_card"
                android:layout_marginEnd="8dp">
                <TextView
                    android:id="@+id/txtStatLow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#F57F17"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Low Stock"
                    android:textSize="11sp"
                    android:textColor="#757575"/>
            </LinearLayout>

            <!-- Critical -->
            <LinearLayout
                android:id="@+id/cardStatCritical"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/rounded_white_card"
                android:layout_marginEnd="8dp">
                <TextView
                    android:id="@+id/txtStatCritical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#B71C1C"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Critical"
                    android:textSize="11sp"
                    android:textColor="#757575"/>
            </LinearLayout>

            <!-- Pending Reservations -->
            <LinearLayout
                android:id="@+id/cardStatReserv"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/rounded_white_card">
                <TextView
                    android:id="@+id/txtStatReserv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#0288D1"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reservations"
                    android:textSize="11sp"
                    android:textColor="#757575"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- ── CRITICAL ALERT BANNER ────────────────────────── -->
    <LinearLayout
        android:id="@+id/ownerAlertBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFEBEE"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/txtOwnerAlertMsg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚠️ Critical stock alert"
            android:textSize="13sp"
            android:textColor="#B71C1C"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View ›"
            android:textSize="13sp"
            android:textColor="#B71C1C"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- ── NAVIGATION TILES ─────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MANAGE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#9E9E9E"
                android:letterSpacing="0.12"
                android:layout_marginBottom="10dp"/>

            <!-- Row 1: Inventory + Reservations -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <!-- Inventory tile -->
                <LinearLayout
                    android:id="@+id/tileInventory"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/rounded_white_card"
                    android:layout_marginEnd="10dp"
                    android:elevation="3dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦"
                        android:textSize="32sp"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inventory"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#212121"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manage stock"
                        android:textSize="11sp"
                        android:textColor="#9E9E9E"/>
                </LinearLayout>

                <!-- Reservations tile -->
                <LinearLayout
                    android:id="@+id/tileReservations"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/rounded_white_card"
                    android:elevation="3dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎟"
                        android:textSize="32sp"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reservations"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#212121"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pickup queue"
                        android:textSize="11sp"
                        android:textColor="#9E9E9E"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Stock Forecast + Settings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Stock forecast tile -->
                <LinearLayout
                    android:id="@+id/tileForecast"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/rounded_white_card"
                    android:layout_marginEnd="10dp"
                    android:elevation="3dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📈"
                        android:textSize="32sp"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stock Forecast"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#212121"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7-day AI prediction"
                        android:textSize="11sp"
                        android:textColor="#9E9E9E"/>
                </LinearLayout>

                <!-- Settings tile -->
                <LinearLayout
                    android:id="@+id/tileOwnerSettings"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/rounded_white_card"
                    android:elevation="3dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️"
                        android:textSize="32sp"
                        android:layout_marginBottom="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notifications"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#212121"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alerts &amp; reminders"
                        android:textSize="11sp"
                        android:textColor="#9E9E9E"/>
                </LinearLayout>
            </LinearLayout>

            <!-- RECENT ACTIVITY label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECENT STOCK ALERTS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#9E9E9E"
                android:letterSpacing="0.12"
                android:layout_marginBottom="10dp"/>

            <!-- Inline alert list (populated programmatically) -->
            <LinearLayout
                android:id="@+id/ownerAlertList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <TextView
                android:id="@+id/txtOwnerNoAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅  All stock levels healthy"
                android:textSize="14sp"
                android:textColor="#757575"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="visible"/>

        </LinearLayout>
    </ScrollView>

    <!-- ── BOTTOM NAV BAR ────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="12dp">

        <LinearLayout
            android:id="@+id/navOwnerHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#E3F2FD">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🏠" android:textSize="20sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Home" android:textSize="10sp" android:textColor="#1565C0" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navOwnerInventory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📦" android:textSize="20sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Inventory" android:textSize="10sp" android:textColor="#757575"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navOwnerReservations"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🎟" android:textSize="20sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Reservations" android:textSize="10sp" android:textColor="#757575"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navOwnerProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="👤" android:textSize="20sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Profile" android:textSize="10sp" android:textColor="#757575"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>